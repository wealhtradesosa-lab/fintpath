{
  "redirects": [
    {
      "source": "/privacidad.html",
      "destination": "/privacidad",
      "permanent": true
    },
    {
      "source": "/",
      "destination": "https://finpathia.com/",
      "permanent": false
    },
    {
      "source": "/:path*",
      "destination": "https://finpathia.com/:path*",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
